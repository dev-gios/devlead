{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Edit(//etc/claude-code/**)",
      "Edit(//etc/devlead/**)",
      "Edit(//opt/devlead/**)",
      "Edit(~/.devlead/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/settings.local.json)",
      "Edit(~/.claude/hooks/**)"
    ]
  },
  "allowManagedHooksOnly": true,
  "allowManagedMcpServersOnly": true,
  "allowedMcpServers": [],
  "autoMemoryEnabled": false,
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "DEVLEAD_GUARD": "1",
    "BASH_ENV": "",
    "ENV": "",
    "NODE_OPTIONS": "",
    "LD_PRELOAD": "",
    "PROMPT_COMMAND": "",
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "GIT_CONFIG_GLOBAL": "/etc/devlead/gitconfig",
    "GIT_CONFIG_NOSYSTEM": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Read|Grep|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "/bin/bash /opt/devlead/hooks/guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "/bin/bash /opt/devlead/hooks/post-edit.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/bin/bash /opt/devlead/hooks/gate-check.sh" }
        ]
      }
    ]
  }
}
