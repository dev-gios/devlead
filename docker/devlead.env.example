# DevLead server — runtime settings for compose.yaml.
#
#   cp docker/devlead.env.example .env && chmod 600 .env
#
# .env (at the repository root) holds secrets: keep it mode 600 and out of git
# (.gitignore already ignores it). compose passes it to the container at start
# and reads DEVLEAD_UID/DEVLEAD_GID from it; nothing in it is copied into the
# image. Values are plain text after the "=", without quotes.

# --- Build (required) ----------------------------------------------------------
# The container runs as your user. Set these to the output of `id -u` and
# `id -g`; compose refuses to build or start while they are empty.
# Changing them needs a rebuild: docker compose up -d --build
DEVLEAD_UID=
DEVLEAD_GID=

# --- Claude (S12) --------------------------------------------------------------
# Long-lived token for your Claude subscription. On a machine with a browser,
# run `claude setup-token`, approve access, and paste the token it prints.
CLAUDE_CODE_OAUTH_TOKEN=
# The day you ran `claude setup-token`, as YYYY-MM-DD. The token lasts one
# year; `devlead doctor` warns from month 11.
DEVLEAD_CLAUDE_TOKEN_ISSUED=

# --- GitHub (S10) --------------------------------------------------------------
# Fine-grained personal access token (GitHub → Settings → Developer settings →
# Fine-grained tokens):
#   Repository access: Only select repositories — the enrolled repos, no others
#   Repository permissions:
#     Contents        Read and write
#     Pull requests   Read and write
#     Issues          Read and write
#     Metadata        Read-only (GitHub adds it on its own)
#   Do NOT grant Workflows, Administration or any other permission. Without
#   Workflows, GitHub rejects any push that changes .github/workflows.
# Backup that only you can turn on: branch protection (or a ruleset) on the
# default branch of every enrolled repo. It is a GitHub setting of each repo
# that you enable yourself; DevLead does not set it.
GH_TOKEN=

# --- Notifications (ntfy) ------------------------------------------------------
# Optional. The URL carries the topic, which is the secret that protects the
# channel. Its host is added to the egress allowlist at start.
DEVLEAD_NTFY_URL=
# Optional, sent as a Bearer token.
DEVLEAD_NTFY_TOKEN=
# 1 adds the repository and the message to the push body (privacy: see
# .devlead/scripts/notify.sh).
DEVLEAD_NOTIFY_DETAIL=

# --- Headless claude runs (S7) ---------------------------------------------------
# The permission flags of every unattended `claude -p` run. Without them the
# runs refuse to start.
DEVLEAD_LOOP_CLAUDE_ARGS=--permission-mode acceptEdits --allowedTools Bash,Read,Edit,Write,Glob,Grep,Agent
# Flags for the weekly discovery run; when unset it uses the line above.
#DEVLEAD_DISCOVER_CLAUDE_ARGS=--permission-mode acceptEdits --allowedTools Bash,Read,Glob,Grep

# --- Egress firewall (S8) --------------------------------------------------------
# The container reaches only Anthropic, GitHub and the ntfy host. Add here, as
# host or host:port (default port 443) separated by commas, anything else the
# enrolled repos need, such as the package registries their tests install from:
#   DEVLEAD_EGRESS_ALLOW=registry.npmjs.org,pypi.org,files.pythonhosted.org
# Names are resolved when the container starts, and those are the only names
# the agent can resolve; restart the container after a change.
DEVLEAD_EGRESS_ALLOW=
