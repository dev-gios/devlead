#!/usr/bin/env bash
# devlead — front-door CLI dispatcher for DevLead.
#
# Pure facade: forwards subcommands to the installed internal scripts under
# ~/.devlead/scripts/. Contains NO subcommand logic of its own. Uses `exec`, so
# the child's exit code and stdio pass through unchanged — `devlead plan` is
# byte-for-byte equivalent to `bash ~/.devlead/scripts/envelope.sh plan`.
# Convention matches .devlead/scripts/*.sh (set -uo pipefail, NOT install's -e).

set -uo pipefail

SCRIPTS_DIR="$HOME/.devlead/scripts"

if [[ ! -d "$SCRIPTS_DIR" ]]; then
  echo "devlead: scripts not installed — run bash install.sh" >&2
  exit 1
fi

_usage() {
  cat <<'EOF'
devlead — front door for DevLead

usage: devlead <command> [args...]

commands:
  init     bootstrap this machine (versioned publish, gh-token), scaffold the
           envelope, then ask once whether to enroll this repo in the daily
           sweep
  upgrade [path]
           publish the devlead repo's current HEAD to this machine (stamps
           ~/.devlead/VERSION); safe to re-run, no-ops when already current.
           optional [path] pins the source checkout explicitly instead of
           trusting ~/.devlead/SOURCE_REPO (escape hatch for a stale anchor)
  plan     produce the recommended plan
  check    run the state check
  show     show current derived state
  sweep    run the plan-only multi-repo sweep
  doctor   report whether the artifacts published to this machine match
           the repo's reviewed trunk (STATUS: ok|drifted|unknown)
  config   interactive setup + envelope menu — machine setup (install
           state, token, timers), this repo's fleet enrollment (fleet-list
           membership + envelope check/enabled state, shown together), and
           this repo's envelope. Refuses to run without an interactive
           terminal (GOVERNANCE.md §A3) and is reachable ONLY from here —
           never from an autonomous path.
  help     show this help

All commands forward to ~/.devlead/scripts/ unchanged.
EOF
}

_cmd="${1:-}"

case "$_cmd" in
  init|upgrade|plan|check|show)
    shift
    exec bash "$SCRIPTS_DIR/envelope.sh" "$_cmd" "$@"
    ;;
  sweep)
    shift
    exec bash "$SCRIPTS_DIR/sweep.sh" "$@"
    ;;
  doctor)
    shift
    exec bash "$SCRIPTS_DIR/doctor.sh" "$@"
    ;;
  config)
    shift
    exec bash "$SCRIPTS_DIR/config.sh" "$@"
    ;;
  # To route a NEW command to a DIFFERENT script later, add its name here:
  #   state)
  #     shift
  #     exec bash "$SCRIPTS_DIR/state.sh" "$@"
  #     ;;
  help|--help|-h|"")
    _usage
    exit 0
    ;;
  *)
    echo "devlead: unknown command '$_cmd'" >&2
    _usage >&2
    exit 2
    ;;
esac
